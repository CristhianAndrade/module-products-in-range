<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="crimson_agility_products_in_range" resource="default" engine="innodb"
           comment="crimson_agility_products_in_range Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="text" name="thumbnail" nullable="true" comment="product thumbnail"/>
        <column xsi:type="text" name="name" nullable="false" comment="product name"/>
        <column xsi:type="text" name="sku" nullable="false" comment="product sku"/>
        <column xsi:type="float" name="price" nullable="false" default="0.00" comment="product price"/>
        <column xsi:type="int" name="qty" nullable="false" default="0" comment="product qty"/>
        <column xsi:type="text" name="link" nullable="true" comment="link to product"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PRODUCTS_IN_RANGE_SKU_UNIQUE">
            <column name="sku"/>
        </constraint>
    </table>
</schema>
